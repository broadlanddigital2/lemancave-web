{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lemancave-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Static Next.js export (npm run build -> ./out). The Worker runs first for /api/* and redirects.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Pages run through the worker (blog, redirects, sitemap, and the AI crawler / AI referral counts for the
    // CRM); images, fonts and Next.js scripts are served straight from the assets.
    "run_worker_first": ["/*", "!/_next/*", "!/images/*", "!/fonts/*", "!/favicon*"]
  },
  "vars": {
    // Race Car Graphics CRM (Supabase) — website form intake, same function Auto Opulence uses
    "CRM_WEBFORM_URL": "https://dipjypzrfigkzuarlsov.supabase.co/functions/v1/inbound-webform-email",
    // LeMan Cave Web Forms channel public key (CRM → channel_integrations)
    "CRM_FORM_KEY": "e12dbb86-3cd9-4065-afa5-31f974d9e710"
  },
  "observability": { "enabled": true }
  // GO-LIVE: when the new site is signed off, add the domain (DNS is already in Cloudflare):
  // ,"routes": [
  //   { "pattern": "lemancave.co.uk", "custom_domain": true },
  //   { "pattern": "www.lemancave.co.uk", "custom_domain": true }
  // ]
}
